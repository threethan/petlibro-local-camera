+// withParameterSets remembers SPS/PPS even when the camera sends them in
+// separate access units, then makes every IDR independently decodable. New
+// RTSP consumers wait for a fresh IDR before receiving dependent frames.
+func (publisher *mediaPublisher) withParameterSets(data []byte, prepend bool) []byte {
+	publisher.mu.Lock()
+	defer publisher.mu.Unlock()
+	var sps, pps []byte
+	for offset := 0; offset < len(data); {
+		start, prefix := annexBStart(data, offset)
+		if start < 0 {
+			break
+		}
+		nalStart := start + prefix
+		next, _ := annexBStart(data, nalStart)
+		nalEnd := len(data)
+		if next >= 0 {
+			nalEnd = next
+		}
+		for nalEnd > nalStart && data[nalEnd-1] == 0 {
+			nalEnd--
+		}
+		if nalStart < nalEnd {
+			switch data[nalStart] & 0x1f {
+			case 7:
+				sps = append([]byte(nil), data[start:nalEnd]...)
+			case 8:
+				pps = append([]byte(nil), data[start:nalEnd]...)
+			}
+		}
+		if next < 0 {
+			break
+		}
+		offset = next
+	}
+	if len(sps) > 0 {
+		publisher.sps = sps
+	}
+	if len(pps) > 0 {
+		publisher.pps = pps
+	}
+	if !prepend || len(publisher.sps) == 0 || len(publisher.pps) == 0 || len(sps) > 0 && len(pps) > 0 {
+		return data
+	}
+	result := make([]byte, 0, len(publisher.sps)+len(publisher.pps)+len(data))
+	result = append(result, publisher.sps...)
+	result = append(result, publisher.pps...)
+	return append(result, data...)
+}
+
+func annexBStart(data []byte, from int) (int, int) {
+	for i := from; i+2 < len(data); i++ {
+		if data[i] != 0 || data[i+1] != 0 {
+			continue
+		}
+		if i+3 < len(data) && data[i+2] == 0 && data[i+3] == 1 {
+			return i, 4
+		}
+		if data[i+2] == 1 {
+			return i, 3
+		}
+	}
+	return -1, 0
+}
