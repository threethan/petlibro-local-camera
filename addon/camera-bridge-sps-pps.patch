+// sendRuntimeControl advances the IOCtrl index established by the three
+// bootstrap commands. Reusing index zero makes the feeder discard AUDIOSTART
+// as a duplicate of SET_STREAM_CTRL even though the command counter changes.
+func (session *Session) sendRuntimeControl(controlType uint32) error {
+	payload := make([]byte, 4+audioControlArgumentSize)
+	binary.LittleEndian.PutUint32(payload, controlType)
+	session.sendMu.Lock()
+	defer session.sendMu.Unlock()
+	index := session.controlIndex
+	session.controlIndex++
+	body := encodeControlData(session.session25.nextOutboundCommand(), controlChannelSystem, index, payload)
+	if err := session.sendBodyLocked(body); err != nil {
+		return fmt.Errorf("send PLAF203 runtime control type=0x%04x index=%d: %w", controlType, index, err)
+	}
+	return nil
+}
