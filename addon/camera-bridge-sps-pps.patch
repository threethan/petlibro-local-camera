+// Each consumer must start on a fresh IDR. Replaying only a cached IDR and then
+// current P-frames omits their reference frames. Republishing that IDR through
+// the shared track also corrupts consumers that were already decoding live.
+func (publisher *mediaPublisher) newConsumerVideoTrack() *core.Receiver {
+	track := core.NewReceiver(publisher.videoMedia, publisher.videoCodec)
+	input := track.Input
+	started := false
+	track.Input = func(packet *rtp.Packet) {
+		if !started {
+			if !h264.IsKeyframe(packet.Payload) {
+				return
+			}
+			started = true
+		}
+		input(packet)
+	}
+	return track
+}
