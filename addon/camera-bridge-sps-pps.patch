+	publisher.publish(&plaf203.VideoFrame{Data: sps})
+	publisher.publish(&plaf203.VideoFrame{Data: pps})
+	track := publisher.newConsumerVideoTrack()
+	var packets []*rtp.Packet
+	track.AppendChild(&core.Node{Input: func(packet *rtp.Packet) { packets = append(packets, packet) }})
+	track.Node.WithParent(&publisher.videoTrack.Node)
+	publisher.publish(&plaf203.VideoFrame{Keyframe: true, Data: []byte{0, 0, 0, 1, 0x65, 0x88}})
+	if len(packets) != 1 || !bytes.Equal(packets[0].Payload, []byte{
+		0, 0, 0, 2, 0x67, 0x42, 0, 0, 0, 2, 0x68, 0xCE, 0, 0, 0, 2, 0x65, 0x88,
+	}) {
+		t.Fatalf("fresh IDR did not include SPS/PPS: %v", packets)
+	}
+}
