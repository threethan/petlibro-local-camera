+func (session *Session) retryAudioStart() {
+	if session.MediaStats().AudioFramesReceived > 0 {
+		return
+	}
+	session.audioMu.Lock()
+	defer session.audioMu.Unlock()
+	if !session.audioEnabled || session.transport == nil || session.Address == nil {
+		return
+	}
+	if err := session.sendRuntimeControl(controlStartAudio); err != nil {
+		emit(session.observer, Event{State: StateStreaming, Address: cloneUDPAddress(session.Address), Step: "audio_start_retry_failed", Error: err.Error()})
+		return
+	}
+	emit(session.observer, Event{State: StateStreaming, Address: cloneUDPAddress(session.Address), Step: "audio_start_retry_tx", ControlType: controlStartAudio})
+}
