+func checkRTSPStartupMode(t *testing.T, enabled bool) {
+	value := "false"
+	if enabled {
+		value = "true"
+	}
+	t.Setenv("PETLIBRO_CAMERA_H264_STARTUP_FIX", value)
+	publisher := newMediaPublisher()
+	idr := &plaf203.VideoFrame{Keyframe: true, Data: []byte{0, 0, 0, 1, 0x65, 0x88}}
+	pframe := &plaf203.VideoFrame{Data: []byte{0, 0, 0, 1, 0x41, 0x99}}
+	publisher.publish(idr)
+	publisher.publish(pframe)
+	server, client := net.Pipe()
+	defer client.Close()
+	consumer := rtsp.NewServer(server)
+	defer consumer.Stop()
+	attached := make(chan error, 1)
+	consumer.Listen(func(event any) {
+		if event == rtsp.MethodDescribe {
+			attached <- publisher.attach(consumer)
+		}
+	})
+	done := make(chan struct{})
+	go func() {
+		_ = consumer.Accept()
+		close(done)
+	}()
+	defer func() { _ = client.Close(); <-done }()
+	writeRTSPRequest(t, client, "DESCRIBE rtsp://localhost/device/test RTSP/1.0\r\nCSeq: 1\r\nAccept: application/sdp\r\n\r\n")
+	readRTSPResponse(t, bufio.NewReader(client))
+	if err := <-attached; err != nil {
+		t.Fatal(err)
+	}
+	if enabled && publisher.videoTrack.Packets != 2 {
+		t.Fatal("attaching viewer injected a cached frame into the shared stream")
+	}
+	if !enabled && publisher.videoTrack.Packets != 3 {
+		t.Fatal("disabled startup fix did not preserve cached keyframe replay")
+	}
+	publisher.publish(pframe)
+	if enabled && consumer.Senders[0].Packets != 0 {
+		t.Fatal("new viewer received a P-frame before a fresh IDR")
+	}
+	if !enabled && consumer.Senders[0].Packets != 2 {
+		t.Fatal("disabled startup fix did not forward cached IDR and live P-frame")
+	}
+	publisher.publish(idr)
+	publisher.publish(pframe)
+	want := 4
+	if enabled {
+		want = 2
+	}
+	if consumer.Senders[0].Packets != want {
+		t.Fatal("new viewer did not receive fresh IDR and subsequent P-frame")
+	}
+}
