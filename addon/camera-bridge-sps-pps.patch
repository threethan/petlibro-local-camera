+func TestNewVideoConsumerWaitsForFreshIDRWithoutInterruptingExistingConsumer(t *testing.T) {
+	publisher := newMediaPublisher()
+	var existing, joining []*rtp.Packet
+	first := publisher.newConsumerVideoTrack()
+	first.AppendChild(&core.Node{Input: func(packet *rtp.Packet) { existing = append(existing, packet) }})
+	first.Node.WithParent(&publisher.videoTrack.Node)
+	idr := &plaf203.VideoFrame{Codec: "h264", Keyframe: true, Data: []byte{0, 0, 0, 1, 0x65, 0x88}}
+	pframe := &plaf203.VideoFrame{Codec: "h264", Data: []byte{0, 0, 0, 1, 0x41, 0x99}}
+	publisher.publish(pframe)
+	if len(existing) != 0 {
+		t.Fatal("consumer received dependent frames before an IDR")
+	}
+	publisher.publish(idr)
+	publisher.publish(pframe)
+	second := publisher.newConsumerVideoTrack()
+	second.AppendChild(&core.Node{Input: func(packet *rtp.Packet) { joining = append(joining, packet) }})
+	second.Node.WithParent(&publisher.videoTrack.Node)
+	if len(existing) != 2 || len(joining) != 0 {
+		t.Fatal("joining consumer caused stale keyframe replay")
+	}
+	publisher.publish(pframe)
+	if len(existing) != 3 || len(joining) != 0 {
+		t.Fatal("join interrupted existing consumer or forwarded undecodable P-frame")
+	}
+	publisher.publish(idr)
+	publisher.publish(pframe)
+	if len(existing) != 5 || len(joining) != 2 {
+		t.Fatalf("existing=%d joining=%d", len(existing), len(joining))
+	}
+	if !bytes.Equal(joining[0].Payload, existing[3].Payload) || !bytes.Equal(joining[1].Payload, existing[4].Payload) {
+		t.Fatal("joining consumer did not receive the fresh IDR followed by live frames")
+	}
+}
+
+func TestFreshIDRIncludesCachedParameterSets(t *testing.T) {
+	publisher := newMediaPublisher()
+	sps := []byte{0, 0, 0, 1, 0x67, 0x42}
+	pps := []byte{0, 0, 0, 1, 0x68, 0xCE}
+	publisher.publish(&plaf203.VideoFrame{Data: sps})
+	publisher.publish(&plaf203.VideoFrame{Data: pps})
+	track := publisher.newConsumerVideoTrack()
+	var packets []*rtp.Packet
+	track.AppendChild(&core.Node{Input: func(packet *rtp.Packet) { packets = append(packets, packet) }})
+	track.Node.WithParent(&publisher.videoTrack.Node)
+	publisher.publish(&plaf203.VideoFrame{Keyframe: true, Data: []byte{0, 0, 0, 1, 0x65, 0x88}})
+	if len(packets) != 1 || !bytes.Equal(packets[0].Payload, []byte{
+		0, 0, 0, 2, 0x67, 0x42, 0, 0, 0, 2, 0x68, 0xCE, 0, 0, 0, 2, 0x65, 0x88,
+	}) {
+		t.Fatalf("fresh IDR did not include SPS/PPS: %v", packets)
+	}
+}
 
